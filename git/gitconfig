[alias]
  a  = add --all
  ap = add --patch
  b  = branch -vv
  co = checkout
  d  = diff -U1
  ds = diff --staged
  l  = log
  r  = reset
  s  = status
  st = stash
  ci = commit --verbose
  p  = push

  # Shows the graph of all branches
  ll = log --graph --oneline --decorate=short -30 --no-merges

  # Quickly amend, use `git amend --edit` to change the message
  amend = commit --amend --no-edit

[push]
  default = current
	autoSetupRemote = true
[pull]
  rebase = true
[merge]
  tool = opendiff
[rebase]
  autosquash = true
	updateRefs = true
[core]
  editor = nvim
  excludesfile = ~/.gitignore
[user]
  name     = Kel Kanhirun
  email    = kel@pillarhq.com
  initials = kk
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[fetch]
	prune = true
